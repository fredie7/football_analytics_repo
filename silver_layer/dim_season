# Import dependencies
from pyspark.sql.functions import regexp_replace, trim, lower, split, array_distinct, col, lit, current_timestamp, sha2, concat_ws

# Read in the silver season data
retrieve_season_data = spark.read \
    .format("delta") \
        .load("abfss://bronze@footballanalyticstorage.dfs.core.windows.net/season_info")

# Refine data
dim_season = (
    retrieve_season_data
        .withColumn("injested_ts", current_timestamp())
        .withColumn("source", lit("football-data.org"))
)

# Write data to silver layer
dim_season.write \
    .format("delta") \
        .mode("append") \
            .save("abfss://silver@footballanalyticstorage.dfs.core.windows.net/dim_season")

